# Plantilla (sí se sube a GitHub, sin valores reales).
# Los valores reales van en Vercel → Project Settings → Environment Variables,
# o en un .env.local que nunca se sube (está en .gitignore).

# ---- Stripe (suscripción del aula, 55 USD al mes) ----
# Developers → API keys → Secret key (sk_live_… o sk_test_… para pruebas)
STRIPE_SECRET_KEY=
# Product catalog → el producto del aula → precio mensual de 55 USD → ID del precio (price_…)
STRIPE_PRICE_ID=
# Developers → Webhooks → el endpoint https://TU-DOMINIO/api/stripe-webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# ---- Firebase (las funciones de Vercel actualizan la cuenta de cada alumna) ----
# El JSON completo de la llave de servicio (Firebase → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada). Se pega tal cual, o codificado en base64.
FIREBASE_SERVICE_ACCOUNT=

# Opcional: dirección pública del sitio para volver desde Stripe (por defecto, la del propio pedido)
# APP_URL=https://casamuladhara.com

# ---- Scripts de administración (en tu computador) ----
# Los scripts de scripts/ leen la llave de servicio de Firebase desde esta ruta;
# guárdala FUERA del repositorio. Por defecto: ~/.config/casamuladhara/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json
