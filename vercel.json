{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/staff",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/n(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=604800"
        }
      ]
    },
    {
      "source": "/curso/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache"
        }
      ]
    }
  ]
}
