rules_version = '2';

// Casa Muladhara · Storage
// Cada alumna solo accede a su carpeta users/{uid}. El material del curso lo sube la Maestra.
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.get('admin', false) == true);
      allow write: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.get('admin', false) == true)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.token.get('admin', false) == true);
    }

    match /courses/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.get('admin', false) == true;
    }
  }
}
